# ─── Notifiche email ────────────────────────────────────────────
# Copia questo file in ".env" e compila con i dati reali della casella.
# NON committare il file .env (contiene la password).

SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=assistenza@sigrafilm.it
SMTP_PASSWORD=la-password-della-casella
SMTP_FROM=assistenza@sigrafilm.it

# Dove arrivano le notifiche
NOTIFY_EMAIL=assistenza@sigrafilm.it

# URL pubblico del sito, usato per il link "Apri il ticket" nelle email
APP_BASE_URL=http://188.8.192.138:5000

# ─── Altro ──────────────────────────────────────────────────────
SECRET_KEY=cambia-questa-chiave
